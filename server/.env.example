# Copy to .env and fill in your own values. Never commit the real .env.
PORT=5000

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-health-insurance

# Any long random string; used to sign JWTs
JWT_SECRET=replace-with-a-long-random-secret

# Optional: used only by `npm run seed:admin`
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@insurecare.local
ADMIN_PASSWORD=Admin123!
